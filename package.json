{
  "name": "talmudon",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 0.0.0.0 --port 5173",
    "dev:electron": "npm run build:main && wait-on http://localhost:5173 && node scripts/run-electron.mjs",
    "start": "npm run dev",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "tsc -b && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "rebuild:electron": "node ./node_modules/@electron/rebuild/lib/main.js -f -w better-sqlite3",
    "postinstall": "npm run rebuild:electron",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hebcal/core": "^6.15.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.1.2",
    "electron": "45.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wait-on": "8.0.0"
  }
}
